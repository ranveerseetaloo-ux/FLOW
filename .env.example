# PipeCore environment configuration

# --- control-plane database ---
# dev default is SQLite; use PostgreSQL in production:
# PIPECORE_DB=postgresql+psycopg2://pipecore:pipecore@postgres:5432/pipecore
PIPECORE_DB=sqlite:///./pipecore.db

# --- reporting store ---
PIPECORE_CLICKHOUSE=clickhouse://clickhouse:9000/pipecore

# --- auth ---
PIPECORE_JWT_SECRET=change-me-in-production
PIPECORE_JWT_TTL_MIN=480

# --- data-plane node control endpoints (comma-separated host:port) ---
PIPECORE_NODES=127.0.0.1:9700

# --- safety: dry-run compiles policy but does NOT push tc to the kernel ---
# set to false only once fail-to-wire bypass + HA are validated
PIPECORE_DRY_RUN=true
